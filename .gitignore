# .NET build artifacts (COQDE runtime DLL is built from build/COQDE/)
build/**/bin/
build/**/obj/
*.user

# Debug flag (presence enables COQDE unmatched-line logging) — dev-only, never shipped
COQDE.debug

# Archived in-game screenshots (kept locally for reference, not in the repo)
docs/screenshots/

# The compiled runtime ships as languages/lang-de/COQDE/COQDE.dll (committed);
# its source lives in build/COQDE/ and is NEVER copied into the game Mods folder
# (the game would compile those .cs files AND load the DLL -> duplicate types).
