# .NET build artifacts (smoke-compile gate)
build/**/bin/
build/**/obj/
*.user

# Archived in-game screenshots & reference material from other language mods
# (kept locally for reference, not in the repo)
docs/screenshots/
docs/archive/
# loose screenshots dropped into the repo root (move to docs/screenshots/)
/Screenshot*.png

# Python (curator tooling)
__pycache__/
*.pyc

# Curator: machine-local state; writer temp files; agent scratch I/O
# (the *_RULES.md briefs in _work/ stay tracked)
build/curator/config.json
build/curator/data/last_sync.json
build/curator/data/proposals/_work/*.json
build/curator/data/findings/*.png
*.curator-tmp
