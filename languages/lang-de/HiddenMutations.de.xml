                    <p>Ihr setzt einen Ausbruch von <stat Name="GasName" /> um euch herum frei.</p>
                </description>
      <leveltext>
                    <p>Setzt Gas fuer <stat Name="Duration" /> frei</p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|Erhoeht <stat Name="LevelEffectDescription" />}}</p></case>
                        <case Value="lower"><p>{{rules|Vermindert <stat Name="LevelEffectDescription" />}}</p></case>
                    </switch>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
                </leveltext>
    </mutation>
