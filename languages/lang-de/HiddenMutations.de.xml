<?xml version="1.0" encoding="utf-8"?>

<mutations Lang="de" Encoding="utf-8" Hidden="true" ExcludeFromPool="true">
  <category Name="Physical">
    <mutation Name="Dark Vision" DisplayName="Nachtsicht" BearerDescription="der Dunkelseher">
      <description></description>
      <leveltext>
                    <p>Ihr seht im Dunkeln.</p>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Smell" DisplayName="Erhoehter Geruchssinn" BearerDescription="jene mit verbessertem Geruchssinn">
      <description>
                    <p>Ihr besitzt aussergewoehnlich scharfen Geruchssinn.</p>
                </description>
      <leveltext>
                    <p>Sie erkennen das Vorhandensein von Kreaturen in einem Bereich von typischerweise <stat Name="Radius" Unit="Platz" /> abhaengig vom Gelaende</p>
                    <switch Name="LevelMatch">
                        <case Value="true"><p>Chance, in der Naehe erkannte Kreaturen zu identifizieren</p></case>
                        <default><p>{{rules|Erhoehte Chance, erkannte Kreaturen in der Naehe zu identifizieren}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Gills" DisplayName="Kiemen" BearerDescription="jene mit Kiemen" />
    <mutation Name="Infiltrate" DisplayName="Infiltrieren" BearerDescription="jene, die eindringen">
      <description>
                    <p>Ihr teleportiert und nehmt Kreaturen mit Euch.</p>
                </description>
      <leveltext>
                    <p>Ihr teleportiert Euch an einen nahegelegenen Ort und nehmt alle innerhalb des Radius <stat Name="TeleportRadius" /> mit Euch.</p>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
                </leveltext>
    </mutation>
    <mutation Name="Heat Absorption" DisplayName="Waermeaufnahme" BearerDescription="jene, die Waerme absorbieren">
      <description>
                    <p>Ihr regeneriert durch Waermeaufnahme.</p>
                </description>
      <leveltext>
                    <p>Immun gegen Waermeschaden</p>
                    <switch Name="HealFactor">
                        <case Value="0" />
                        <default><p>Jedes Mal, wenn Ihr Hitzeschaden erleiden wuerdet, heilt Ihr stattdessen fuer <stat Name="HealFactor" />% dieses Schadens</p></default>
                    </switch>
                </leveltext>
    </mutation>
