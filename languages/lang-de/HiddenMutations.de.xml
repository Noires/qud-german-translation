  <category Name="Physical">
    <mutation Name="Dark Vision" DisplayName="Nachtsicht" BearerDescription="der Dunkelseher">
      <description></description>
      <leveltext>
                    <p>Du siehst im Dunkeln.</p>
                </leveltext>
    </mutation>
    <mutation Name="Heightened Smell" DisplayName="Erhöhter Geruchssinn" BearerDescription="jene mit verbessertem Geruchssinn">
      <description>
                    <p>Du besitzt außergewöhnlich scharfen Geruchssinn.</p>
                </description>
      <leveltext>
                    <p>Du erkennst das Vorhandensein von Kreaturen in einem Bereich von typischerweise <stat Name="Radius" Unit="Platz" /> abhängig vom Gelände</p>
                    <switch Name="LevelMatch">
                        <case Value="true"><p>Chance, in der Nähe erkannte Kreaturen zu identifizieren</p></case>
                        <default><p>{{rules|Erhöhte Chance, erkannte Kreaturen in der Nähe zu identifizieren}}</p></default>
                    </switch>
                </leveltext>
    </mutation>
    <mutation Name="Gills" DisplayName="Kiemen" BearerDescription="jene mit Kiemen" />
    <mutation Name="Infiltrate" DisplayName="Infiltrieren" BearerDescription="jene, die eindringen">
      <description>
                    <p>Du teleportierst und nimmst Kreaturen mit dir.</p>
                </description>
      <leveltext>
                    <p>Du teleportierst dich an einen nahegelegenen Ort und nimmst alle innerhalb des Radius <stat Name="TeleportRadius" /> mit dir.</p>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
                </leveltext>
    </mutation>
    <mutation Name="Heat Absorption" DisplayName="Wärmeaufnahme" BearerDescription="jene, die Wärme absorbieren">
      <description>
                    <p>Du regenerierst durch Wärmeaufnahme.</p>
                </description>
      <leveltext>
                    <p>Immun gegen Wärmeschaden</p>
                    <switch Name="HealFactor">
                        <case Value="0" />
                        <default><p>Jedes Mal, wenn du Hitzeschaden erleiden würdest, heilst du stattdessen für <stat Name="HealFactor" />% dieses Schadens</p></default>
                    </switch>
                </leveltext>
    </mutation>
