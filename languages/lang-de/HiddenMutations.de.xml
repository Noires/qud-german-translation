                    <p>Du spiegelst das schmachvolle Antlitz nahegelegener Kreaturen wider.</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Repelling Force" DisplayName="Abstoßende Kraft" BearerDescription="die Abstoßung">
      <description>
                    <p>Du beschwörst eine abstoßende Kraft im umgebenden Bereich und wirft Feinde zurück.</p>
                </description>
      <leveltext>
                    <statline Name="Area" DisplayName="Bereich" />
                    <switch Name="LevelMatch">
                        <case Value="true"><p>Kreaturen werden vom Zentrum der Explosion weggestoßen.</p></case>
                        <default><p>{{rules|Erhöhte Stoßkraft}}</p></default>
                    </switch>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
