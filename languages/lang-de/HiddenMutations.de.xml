                    <p>Ihr spiegelt das schmachvolle Antlitz nahegelegener Kreaturen wider.</p>
                </description>
      <leveltext></leveltext>
    </mutation>
    <mutation Name="Repelling Force" DisplayName="Abstossende Kraft" BearerDescription="die Abstossung">
      <description>
                    <p>Ihr beschwoert eine abstossende Kraft im umgebenden Bereich und wirft Feinde zurueck.</p>
                </description>
      <leveltext>
                    <statline Name="Area" DisplayName="Bereich" />
                    <switch Name="LevelMatch">
                        <case Value="true"><p>Kreaturen werden vom Zentrum der Explosion weggestossen.</p></case>
                        <default><p>{{rules|Erhoehte Stosskraft}}</p></default>
                    </switch>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
