    <mutation Name="Plasma Emission" DisplayName="Plasmaemission" BearerDescription="jene, die Plasma aussenden">
      <description>
                    <p>Du setzt einen Ausbruch von <stat Name="GasName" /> um dich herum frei.</p>
                </description>
      <leveltext>
                    <p>Setzt Gas für <stat Name="Duration" /> frei</p>
                    <switch Name="LevelMatch">
                        <case Value="raise"><p>{{rules|Erhöht <stat Name="LevelEffectDescription" />}}</p></case>
                        <case Value="lower"><p>{{rules|Vermindert <stat Name="LevelEffectDescription" />}}</p></case>
                    </switch>
                    <statline Name="Cooldown" DisplayName="Abklingzeit" />
                </leveltext>
    </mutation>
