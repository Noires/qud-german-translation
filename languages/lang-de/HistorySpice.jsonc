    "gossip": {
      "twoFaction=": [
        "=f1= stahl =item.a==item.name|strip= von =f2=.",
        "=f1= verkaufte =item.a==item.name|strip= für zu viel Geld an =f2=.",
        "=f1= erschlug einen Anführer von =f2=.",
        "=f1= säte Zweifel am Glauben von =f2=.",
        "=f1= beleidigte die Frauen von =f2=.",
        "=f1= trickste =f2= dazu, etwas von ihrem Frischwasser zu teilen.",
        "=f1= besäte die Felder von =f2= mit Salz.",
        "=f1= widerlegte einen berühmten Lehrsatz von =f2=.",
        "=f1= grub einige Vorfahren von =f2= aus.",
        "=f1= steckte ein Dorf von =f2= in Brand.",
        "=f1= besiegte =f2= wiederholt beim Würfeln.",
        "=f1= ließ Schlangen in ein Lager von =f2= los.",
        "=f1= verunglimpfte einen berühmten Dichter, den =f2= verehrte.",
        "=f1= vergiftete das Frischwasser von =f2=.",
        "=f1= gab sich als Anführer von =f2= aus.",
        "=f1= führte einen Überfall auf ein Lager von =f2=.",
        "=f1= kochte =f2= eine ranzige Mahlzeit.",
        "=f1= erzählte =f2= schlüpfrige Witze.",
        "=f1= entzündete ein Signalfeuer, um die Feinde von =f2= zu warnen.",
        "=f1= verweigerte =f2= den Zutritt zu einer örtlichen Bibliothek.",
        "=f1= verkaufte einem Abenteurer eine Karte zu einem Schatzgewölbe von =f2=.",
        "=f1= aß einen Haufen Früchte, die =f2= gehörten.",
        "=f1= programmierte einen Roboter von =f2= um.",
        "=f1= verbrannte einen Anführer von =f2= im Bildnis.",
        "=f1= gab =f2= ungünstige Horoskope.",
        "=f1= stellte den Ursprung des Mondes infrage und beleidigte damit den Glauben von =f2=.",
        "=f1= lobte ein hochentropisches Wesen und beleidigte damit =f2=."
      ],
