        "UIText",
        "GameSummary"
      ],
      "pattern": "^(?<pre>[\\s\\S]*?)[Yy]ou were illuminated to death by (?<killer>.+?)\\.(?:\\s*\\[[^\\]]*\\])?\\s*$",
