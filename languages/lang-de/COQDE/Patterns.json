        "UIText",
        "GameSummary"
      ],
      "pattern": "^(?<pre>[\\s\\S]*?)[Yy]ou were lased to death by (?<killer>.+?)\\.(?:\\s*\\[[^\\]]*\\])?\\s*$",
      "replacement": "{pre}Ihr wurdet von {killer:dat} mit einem Laser getötet."
    },
    {
