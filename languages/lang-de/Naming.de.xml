<?xml version="1.0" encoding="utf-8"?>
<!--
  Prozedurale Namensgenerierung (Sultane, Helden-Titel, Wildnis-Orte, Dorf-Rollen).
  PARTIELLE Datei: Nur namestyles mit echtem englischem Inhalt werden überschrieben
  (templates bzw. templatevars mit Load="Replace"); Silben-Pools und rein token-basierte
  Stile erben unverändert aus Base/Naming.xml.

  WICHTIG - Substring-Kontrakt: Die Hero-ObjectBuilder (z. B. BaboonHero1) prüfen den
  generierten Titel per text.Contains(Strings._S("<X> Naming.xml Context", "King")).
  Jeder hier erzeugte Wert MUSS den zugehörigen Strings.de.xml-Wert desselben Kontexts
  als Teilstring enthalten (deklinierte Formen wie "gelehrte" ⊇ "gelehrt" sind ok),
  sonst verlieren Helden ihre wertabhängigen Boni. Beide Seiten synchron pflegen!
-->
<naming Encoding="utf-8" Lang="de">
  <namestyles HyphenSeparator="-" NameSeparator=" ">

