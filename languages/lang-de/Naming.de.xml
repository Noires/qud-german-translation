    <!-- ==== Ziegenvolk-/Qlippoth-Orte: TitleCase-Komposita (Schwarz+wald = Schwarzwald).
         templatevars Load="Replace" ersetzt ALLE Variablen des Stils - daher werden auch
         die unveränderten (sultan, suffix-Meckerlaute) mitgeliefert. ==== -->
    <namestyle Name="Goatfolk Site">
      <templatevars Load="Replace">
        <templatevar Name="prefix">
          <value Name="Asch" /><value Name="Schwarz" /><value Name="Blut" /><value Name="Knochen" />
          <value Name="Spalt" /><value Name="Farn" /><value Name="Herz" /><value Name="Mond" />
          <value Name="Moos" /><value Name="Regen" /><value Name="Harz" /><value Name="Schädel" />
          <value Name="Stern" /><value Name="Weiß" />
        </templatevar>
        <templatevar Name="sultan">
          <value Name="Resheph" />
        </templatevar>
        <templatevar Name="suffix">
          <value Name="bäh" /><value Name="bääääääh" /><value Name="bäääääh" /><value Name="bääääh" />
          <value Name="bäääh" /><value Name="bääh" /><value Name="määh" /><value Name="määääääh" />
          <value Name="määääh" /><value Name="määääh" /><value Name="määäh" /><value Name="rah" />
          <value Name="rääääääh" /><value Name="räääääh" /><value Name="rääääh" /><value Name="räääh" />
          <value Name="rääh" />
        </templatevar>
        <templatevar Name="forest">
          <value Name="gehölz" /><value Name="tal" /><value Name="grund" /><value Name="lichtung" />
          <value Name="klamm" /><value Name="schlucht" /><value Name="hain" /><value Name="wiese" />
          <value Name="wurzel" /><value Name="au" /><value Name="forst" /><value Name="klage" />
          <value Name="wald" />
        </templatevar>
        <templatevar Name="location">
          <value Name="bogen" /><value Name="biss" /><value Name="bucht" /><value Name="spalt" />
          <value Name="sichel" /><value Name="tiefe" /><value Name="teich" /><value Name="stern" />
          <value Name="leere" /><value Name="brunn" />
        </templatevar>
      </templatevars>
